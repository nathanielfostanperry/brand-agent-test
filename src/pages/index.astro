---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import PlatformSection from "../components/PlatformSection.astro";
import CapabilitiesSection from "../components/CapabilitiesSection.astro";
import ApplicationsSection from "../components/ApplicationsSection.astro";
import InsightsSection from "../components/InsightsSection.astro";
---

<BaseLayout>
  <Navbar />
  <main>
    <!-- Hero: full-width container for rounded card -->
    <div style="padding: 0 36px; background: var(--color-white);">
      <Hero />
    </div>

    <!-- Platform: Securing Materials -->
    <PlatformSection />

    <!-- Capabilities: Supply Chain Grid -->
    <CapabilitiesSection />

    <!-- Applications: Strategic Technologies Accordion -->
    <ApplicationsSection />

    <!-- Insights: Thought Leadership -->
    <InsightsSection />
  </main>
</BaseLayout>
