---
import InsightsCarousel from "./InsightsCarousel.tsx";
---

<section
  id="insights"
  style="background: var(--color-nickel); padding: 70px 0;"
>
  <div
    style="
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 36px;
      display: flex;
      flex-direction: column;
      gap: 60px;
    "
  >
    <!-- Header -->
    <div
      style="
        max-width: 900px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      "
    >
      <h2
        style="
          font-family: var(--font-headings);
          font-weight: 800;
          font-size: var(--text-headline);
          color: var(--color-keystone);
          line-height: var(--leading-headline-md);
        "
      >
        Thought leadership from our team
      </h2>
      <p
        style="
          font-family: var(--font-body);
          font-weight: 300;
          font-size: var(--text-body-lg);
          color: #646468;
          line-height: var(--leading-body);
          letter-spacing: 0.6px;
        "
      >
        Explore recent updates and perspectives from the Principal Mineral team.
      </p>
    </div>

    <!-- Carousel (React island) -->
    <InsightsCarousel client:visible />
  </div>
</section>
