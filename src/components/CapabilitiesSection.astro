---
const capabilityImage = "http://localhost:3845/assets/c25e23f2cabfed8b59da1846f60a43077d8c9f0e.png";

const capabilities = [
  {
    title: "Recycling",
    body: "Building market infrastructure to collect and process recycled rare earth elements, copper, and other critical materials to support domestic production and a sustainable future.",
    image: capabilityImage,
  },
  {
    title: "Processing",
    body: "Implementing innovative technologies to efficiently and safely scale rare earth element processing in the U.S.",
    image: capabilityImage,
  },
  {
    title: "Advanced Manufacturing",
    body: "Integrating cutting edge technology, processes, and tools to enable efficient and sustainable manufacturing across material and mineral supply chains.",
    image: capabilityImage,
  },
  {
    title: "Systems Integration",
    body: "Brief, one-liner articulating type of capability, lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.",
    image: capabilityImage,
  },
];
---

<section
  id="capabilities"
  style="background: var(--color-nickel); padding: 72px 0;"
>
  <div
    style="display: flex; flex-direction: column; gap: 60px; align-items: center;"
  >
    <!-- Header -->
    <div
      style="
        text-align: center;
        max-width: 1100px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 0 36px;
      "
    >
      <h2
        style="
          font-family: var(--font-headings);
          font-weight: 800;
          font-size: var(--text-headline);
          color: var(--color-keystone);
          line-height: var(--leading-headline-md);
        "
      >
        A solutions provider scaling mineral supply chains
      </h2>
      <p
        style="
          font-family: var(--font-body);
          font-weight: 300;
          font-size: var(--text-body-lg);
          color: #646468;
          max-width: 850px;
          line-height: var(--leading-body);
          letter-spacing: 0.6px;
          margin: 0 auto;
        "
      >
        Principal Mineral addresses supply chain weaknesses across a
        diversified set of mineral and material supply chains to power
        essential technologies.
      </p>
    </div>

    <!-- 2×2 Grid -->
    <div
      class="capabilities-grid"
      style="
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 72px;
        width: 100%;
        max-width: 1440px;
        padding: 0 36px;
      "
    >
      {
        capabilities.map((cap) => (
          <article
            style="
              display: flex;
              flex-direction: column;
              padding-bottom: 36px;
            "
          >
            <!-- Image — negative bottom margin pulls content up by 36px -->
            <div
              style="
                height: 290px;
                overflow: hidden;
                position: relative;
                z-index: 0;
                margin-bottom: -36px;
              "
            >
              <img
                src={cap.image}
                alt=""
                style="
                  position: absolute;
                  top: -60%;
                  left: -2.6%;
                  width: 105.32%;
                  height: 160.7%;
                  object-fit: cover;
                  max-width: none;
                "
              />
            </div>

            <!-- Content — overlaps bottom 36px of image -->
            <div
              style="
                background: var(--color-white);
                padding: 32px;
                border-radius: 0 36px 0 0;
                display: flex;
                flex-direction: column;
                gap: 8px;
                position: relative;
                z-index: 1;
                flex: 1;
                margin-bottom: -36px;
              "
            >
              <h3
                style="
                  font-family: var(--font-headings);
                  font-weight: 800;
                  font-size: var(--text-subhead);
                  color: var(--color-keystone);
                  text-transform: uppercase;
                  line-height: var(--leading-headline-md);
                  margin: 0;
                "
              >
                {cap.title}
              </h3>
              <p
                style="
                  font-family: var(--font-body);
                  font-weight: 300;
                  font-size: var(--text-body-lg);
                  color: #75757a;
                  line-height: var(--leading-body);
                  letter-spacing: 0.6px;
                  margin: 0;
                "
              >
                {cap.body}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <!-- CTA -->
    <div>
      <a href="/capabilities" class="btn btn-secondary">About our capabilities</a
      >
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .capabilities-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
