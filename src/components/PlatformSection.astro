---
const icon1 = "http://localhost:3845/assets/e4dee13ae8b179ee616ff516d78c5f2467ac8f90.png";
const icon2 = "http://localhost:3845/assets/dab1f053d36d1b1d207d18d2db47b59026f1c174.png";
const icon3 = "http://localhost:3845/assets/d008e2f8691c1c9678e554f557692199f11f3fc7.png";
const icon4 = "http://localhost:3845/assets/bbe7bbad903dfed3044b43c48fd73529ee04ee6d.png";

const pillars = [
  {
    icon: icon1,
    title: "Re-establishing",
    body: "Advancing strategic investments to re-establish core infrastructure and U.S. industrial strength.",
  },
  {
    icon: icon2,
    title: "Developing",
    body: "Advancing new, scalable processing technologies that drive efficiency, recovery, and output.",
  },
  {
    icon: icon3,
    title: "Leading",
    body: "Catalyzing an era of new market formation by activating infrastructure and forging partnerships.",
  },
  {
    icon: icon4,
    title: "Investing",
    body: "Deploying disciplined capital to reinforce domestic production, workers, and communities.",
  },
];
---

<section
  id="platform"
  style="padding: 70px 36px; max-width: 1440px; margin: 0 auto;"
>
  <div style="display: flex; flex-direction: column; gap: 48px;">
    <!-- Header -->
    <div style="display: flex; flex-direction: column; gap: 8px;">
      <h2
        style="
          font-family: var(--font-headings);
          font-weight: 800;
          font-size: var(--text-headline);
          color: var(--color-keystone);
          line-height: var(--leading-headline-md);
          max-width: 1324px;
        "
      >
        Securing materials to build our future
      </h2>
      <p
        style="
          font-family: var(--font-body);
          font-weight: 300;
          font-size: var(--text-body-lg);
          color: #75757a;
          max-width: 600px;
          line-height: var(--leading-body);
          letter-spacing: 0.6px;
        "
      >
        Principal Mineral strengthens industry and revitalizes our pioneering
        potential. We're doing this by:
      </p>
    </div>

    <!-- Pillars grid -->
    <div
      style="display: flex; flex-direction: column; gap: 29px; max-width: 1324px;"
    >
      <div
        class="platform-grid"
        style="display: grid; grid-template-columns: repeat(4, 285px); gap: 59px;"
      >
        {
          pillars.map((pillar) => (
            <article style="display: flex; flex-direction: column; gap: 17px;">
              <div style="width: 125px; height: 125px; flex-shrink: 0;">
                <img
                  src={pillar.icon}
                  alt=""
                  style="width: 100%; height: 100%; object-fit: cover;"
                />
              </div>
              <h3
                style="
                  font-family: var(--font-headings);
                  font-weight: 800;
                  font-size: var(--text-subhead);
                  color: var(--color-highlight);
                  text-transform: uppercase;
                  line-height: var(--leading-headline-md);
                  margin: 0;
                "
              >
                {pillar.title}
              </h3>
              <p
                style="
                  font-family: var(--font-body);
                  font-weight: 300;
                  font-size: var(--text-body-lg);
                  color: #75757a;
                  line-height: var(--leading-body);
                  letter-spacing: 0.6px;
                  margin: 0;
                "
              >
                {pillar.body}
              </p>
            </article>
          ))
        }
      </div>

      <!-- CTA -->
      <div>
        <a href="/platform" class="btn btn-secondary">About our platform</a>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 1280px) {
    .platform-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  @media (max-width: 640px) {
    .platform-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
