---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Principal Mineral | Intelligence Platform for Strategic Materials",
  description = "Principal Mineral develops and scales domestic production of strategic metals, high-performance alloys, and advanced materials. Reducing risk and ensuring competitiveness across America's most important supply chains.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Commuters Sans via Adobe Fonts (Typekit) -->
    <!-- Geologica via Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geologica:wght@300;400;500&family=Montserrat:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      /* Commuters Sans fallback via Montserrat until Adobe Fonts loaded */
      :root {
        --font-headings: "Montserrat", sans-serif;
        --font-body: "Geologica", sans-serif;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
